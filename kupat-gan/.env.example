# ---- כללי ----
PORT=3000
# כתובת ציבורית של השרת (נדרשת לספקי הטלפוניה כדי לחזור אלינו)
PUBLIC_URL=https://kupat-gan.example.co.il
# סיסמת כניסה לממשק הניהול
ADMIN_PASSWORD=change-me
# מחרוזת סודית אקראית (חתימת עוגיות ונתיב ה-IVR). לייצר: node -e "console.log(crypto.randomUUID())"
APP_SECRET=
DB_PATH=./data/kupat-gan.db

# ---- שעות חיוג (שעון ישראל) ----
CALL_HOURS_START=09:30
CALL_HOURS_END=20:30
# יום שישי וערבי חג: לא מחייגים מהשעה הזו
EREV_CUTOFF=12:00
# תאריכים נוספים לחסימה (YYYY-MM-DD, מופרדים בפסיק)
BLOCKED_DATES=
# כל כמה שניות המחייג בודק אם יש למי להתקשר
DIALER_INTERVAL_SECONDS=60

# ---- ספק טלפוניה: mock | yemot | twilio ----
PHONE_PROVIDER=mock

# ימות המשיח
YEMOT_NUMBER=
YEMOT_PASSWORD=
# מזהה תבנית הקמפיין במערכת (ראו README)
YEMOT_TEMPLATE_ID=
YEMOT_CALLER_ID=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- סליקה: mock | tranzila ----
PAYMENT_PROVIDER=mock
TRANZILA_SUPPLIER=
TRANZILA_PASSWORD=
